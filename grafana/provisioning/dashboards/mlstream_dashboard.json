{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "gauge",
      "title": "Real-Time Composite Drift Score",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "mlstream_concept_drift_score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.15 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Drift Status Alarm",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "mlstream_is_drifting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NORMAL", "color": "green" }, "1": { "text": "DRIFT DETECTED", "color": "red" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Automated Retrain Triggers",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "mlstream_retrain_events_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inference Request Throughput (RPS)",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(mlstream_predictions_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 & P99 Latency (Seconds)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(mlstream_prediction_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(mlstream_prediction_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "P99 Latency",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "drift", "monitoring"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "MLStream Real-Time MLOps & Drift Observability Dashboard",
  "uid": "mlstream-observability-v1"
}
